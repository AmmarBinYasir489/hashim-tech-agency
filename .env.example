# Copy this file to `.env` and fill in the real values.

# Upstash Redis REST credentials (used by server APIs)
UPSTASH_REDIS_REST_URL=https://<your-upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# Admin password for /admin login (choose a strong password)
ADMIN_PASSWORD=change_me_to_a_strong_password

# Example: Next.js runtime environment
NODE_ENV=development
